#!/bin/sh
# Manejo del token local de One Brain.
OB_BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)
. "$OB_BIN_DIR/../scripts/state-dir.sh"
DIR=$(ob_state_dir)
FILE="$DIR/token"
URL="${ONE_BRAIN_URL:-https://onebrain.prophet.lat}"
case "$1" in
  set)
    [ -n "$2" ] || { echo "uso: onebrain-token set <token>" >&2; exit 1; }
    # El token es UNO por perfil: guardar otro deja a la persona afuera del cerebro anterior.
    # Reconectar al mismo (se rotó la llave, se reinstaló el plugin) es rutina y no se avisa.
    if [ -r "$FILE" ]; then
      ANTERIOR=$(tr -d ' \t\r\n' < "$FILE")
      if [ -n "$ANTERIOR" ] && [ "$ANTERIOR" != "$2" ]; then
        echo "one-brain: ojo, este perfil ya estaba conectado a otro cerebro y lo estás reemplazando."
        echo "one-brain: cada perfil tiene su propio cerebro. Para volver al anterior necesitás su token."
      fi
    fi
    mkdir -p "$DIR"; printf '%s' "$2" > "$FILE"; chmod 600 "$FILE"
    rm -f "$DIR/heredado" 2>/dev/null
    echo "one-brain: token guardado en $FILE" ;;
  get)
    [ -r "$FILE" ] && cat "$FILE" || { echo "sin token" >&2; exit 1; } ;;
  check)
    # Responde SI HAY token, sin revelarlo. Existe porque `get` lo imprime en claro, y cuando
    # una skill le pide al modelo que lo corra sólo para saber si está conectado, la credencial
    # queda escrita en el registro local de la sesión (el rollout de Codex, el transcript del
    # otro programa) en texto plano y para siempre. Decirle al modelo "no lo muestres" no
    # alcanza: para cuando lee esa orden, el token ya salió por pantalla y ya quedó guardado.
    # `get` se conserva para lo que de verdad necesita el valor (mandarlo en un header).
    [ -r "$FILE" ] || { echo "one-brain: sin token en $FILE" >&2; exit 1; }
    N=$(tr -d ' \t\r\n' < "$FILE" | wc -c | tr -d ' ')
    [ "$N" -ge 10 ] || { echo "one-brain: el token guardado está vacío o truncado ($N caracteres)" >&2; exit 1; }
    echo "one-brain: hay token guardado en $FILE ($N caracteres)" ;;
  verify)
    [ -r "$FILE" ] || { echo "sin token" >&2; exit 1; }
    TOKEN=$(tr -d ' \t\r\n' < "$FILE")
    CODE=$(curl -s -o /dev/null -w "%{http_code}" -X POST \
      -H "Authorization: Bearer $TOKEN" \
      -H "content-type: application/json" \
      -H "accept: application/json, text/event-stream" \
      -d '{"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}' \
      "$URL/api/mcp")
    [ "$CODE" = "200" ] && echo "one-brain: conexión OK" || { echo "one-brain: falló ($CODE)" >&2; exit 1; } ;;
  *) echo "uso: onebrain-token set|check|get|verify" >&2; exit 1 ;;
esac
