#!/bin/sh
# onebrain-resolve-pending <session-id>: borra la marca pending-<session-id> tras un guardado
# CONFIRMADO. La skill session-capture la corre SOLO cuando el rescate de una sesión anterior
# se guardó bien (brain_save/onebrain-save devolvieron entry_id); si el guardado falló, NO se
# llama — el aviso de SessionStart debe seguir insistiendo en el próximo arranque.
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$DIR/../scripts/capture-lib.sh"
[ -n "$1" ] || { echo "onebrain-resolve-pending: falta <session-id>" >&2; exit 2; }
ob_resolve_pending "$1"
