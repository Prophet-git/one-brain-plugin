#!/usr/bin/env node
// onebrain-secret — usar una clave del equipo SIN que su valor pase por la conversación.
//
// Uso:
//   onebrain-secret <NOMBRE>                      la deja en el portapapeles
//   onebrain-secret <NOMBRE> --a <archivo.env>    la escribe en ese archivo de entorno
//   onebrain-secret --lista                       qué claves tiene el equipo
//   onebrain-secret <NOMBRE> --guardar-desde <archivo.env> [--para "texto"]   la sube
//
// QUÉ IMPRIME (esto sí lo lee el modelo): el nombre de la clave y qué se hizo con ella.
// QUÉ NUNCA IMPRIME: el valor. Ese viaja del server al portapapeles o al disco, y nada más.
//
// EL VALOR NUNCA VA COMO ARGUMENTO, ni al guardar: los argumentos quedan en el historial de la
// shell y a la vista en la lista de procesos de la máquina. Por eso se sube leyéndolo de un
// archivo que la persona ya tiene, o se carga desde la pestaña Claves del panel.

import { readFileSync, writeFileSync, existsSync } from "node:fs";
import { execFileSync } from "node:child_process";
import { homedir, platform } from "node:os";
import { join, resolve } from "node:path";
import { mergeEnv, skillCmd } from "../scripts/project-lib.mjs";
import { preguntar, esSi } from "../scripts/tty.mjs";

const URL_BASE = process.env.ONE_BRAIN_URL || "https://onebrain.prophet.lat";

function salir(msg, codigo = 1) {
  console.error(msg);
  process.exit(codigo);
}

function token() {
  const f = join(process.env.ONE_BRAIN_CONFIG_DIR || join(homedir(), ".config", "one-brain"), "token");
  if (!existsSync(f)) salir(`one-brain: sin token. Conectá con ${skillCmd("connect")} <token>.`);
  return readFileSync(f, "utf8").trim();
}

/** La confirmación se le pide a la TERMINAL, no a la entrada estándar. Es la defensa central:
 *  el modelo puede ejecutar este comando —una inyección en un README puede pedirlo— pero no
 *  puede apretar una tecla en la terminal de la persona. Sin terminal no sale ninguna clave:
 *  falla cerrado, porque un "asumamos que sí" acá convierte la caja fuerte en un repartidor. */
function confirmar(pregunta) {
  const r = preguntar(pregunta);
  if (r === null) {
    salir("one-brain: hace falta una terminal para confirmar que salga una clave.\n" +
      "Corré el comando vos mismo en tu terminal (no dentro de un pipe ni de un script).");
  }
  if (!esSi(r)) salir("one-brain: cancelado, no salió ninguna clave.", 0);
}

async function pedir(ruta, opciones) {
  const res = await fetch(`${URL_BASE}${ruta}`, {
    ...opciones,
    headers: { authorization: `Bearer ${token()}`, "content-type": "application/json", ...(opciones?.headers || {}) },
  });
  const cuerpo = await res.json().catch(() => ({}));
  if (!res.ok) salir(`one-brain: ${cuerpo.error || `el server respondió ${res.status}`}`);
  return cuerpo;
}

/** Al portapapeles según el sistema. Se le pasa por entrada estándar y no como argumento, por
 *  el mismo motivo de siempre: un argumento se ve desde afuera del proceso. */
function alPortapapeles(valor) {
  const cmd = platform() === "darwin" ? ["pbcopy", []]
    : platform() === "win32" ? ["clip", []]
    : process.env.WAYLAND_DISPLAY ? ["wl-copy", []]
    : ["xclip", ["-selection", "clipboard"]];
  try {
    execFileSync(cmd[0], cmd[1], { input: valor, stdio: ["pipe", "ignore", "ignore"] });
    return true;
  } catch {
    return false;
  }
}

/** Lee UNA variable de un archivo de entorno. No usa dotenv ni evalúa nada: sólo busca la
 *  línea de esa asignación. Un archivo de entorno ajeno puede tener cualquier cosa adentro. */
function leerDelEnv(archivo, nombre) {
  if (!existsSync(archivo)) salir(`one-brain: no existe el archivo ${archivo}.`);
  for (const linea of readFileSync(archivo, "utf8").split("\n")) {
    const m = new RegExp(`^\\s*${nombre}\\s*=(.*)$`).exec(linea);
    if (m) return m[1].trim().replace(/^["']|["']$/g, "");
  }
  return null;
}

// Parseo a mano y en un solo paso: las opciones que llevan valor se lo comen, y lo primero que
// sobra es el nombre de la clave. Buscar con indexOf() por opción se equivoca apenas un valor
// se parece a otra opción o se repite.
const CON_VALOR = new Set(["--a", "--guardar-desde", "--para"]);
const args = process.argv.slice(2);
const opciones = new Map();
let nombre = null;
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (CON_VALOR.has(a)) { opciones.set(a, args[++i] ?? null); continue; }
  if (a.startsWith("--")) { opciones.set(a, true); continue; }
  if (nombre === null) nombre = a;
}
const flag = (n) => {
  const v = opciones.get(n);
  return typeof v === "string" ? v : null;
};

if (opciones.has("--lista") || (!nombre && args.length === 0)) {
  const { claves } = await pedir("/api/team-secret", { method: "GET" });
  if (!claves.length) {
    console.log("\n  El equipo todavía no guardó ninguna clave.");
    console.log("  Se cargan desde la pestaña Claves del panel, o con --guardar-desde.\n");
    process.exit(0);
  }
  console.log(`\n  Claves del equipo (${claves.length}):\n`);
  for (const c of claves) {
    const donde = c.referencia_externa ? `  → en bóveda externa: ${c.referencia_externa}` : "";
    console.log(`  ${c.nombre}${c.descripcion ? `\n     ${c.descripcion}` : ""}${donde}`);
  }
  console.log(`\n  Para usar una: onebrain-secret <NOMBRE>\n`);
  process.exit(0);
}

if (!nombre) salir("uso: onebrain-secret <NOMBRE> [--a <archivo.env>] | --lista | <NOMBRE> --guardar-desde <archivo.env>");

const desde = flag("--guardar-desde");
if (desde) {
  const archivo = resolve(desde);
  const valor = leerDelEnv(archivo, nombre);
  if (!valor) salir(`one-brain: ${archivo} no tiene ninguna línea ${nombre}=…`);
  const { clave } = await pedir("/api/team-secret", {
    method: "POST",
    body: JSON.stringify({ nombre, valor, descripcion: flag("--para") || undefined, origen: "la terminal" }),
  });
  console.log(`\n  Guardada: ${clave.nombre}${clave.descripcion ? ` — ${clave.descripcion}` : ""}`);
  console.log("  Ya la puede usar cualquiera del equipo con: onebrain-secret " + clave.nombre + "\n");
  process.exit(0);
}

const archivoDestino = flag("--a");
confirmar(archivoDestino
  ? `¿Escribo la clave ${nombre} en ${archivoDestino}?`
  : `¿Copio la clave ${nombre} al portapapeles?`);

const { clave } = await pedir("/api/team-secret/pull", {
  method: "POST",
  body: JSON.stringify({ nombre, origen: process.env.ONE_BRAIN_ORIGEN || "la terminal" }),
});

if (clave.referencia_externa) {
  console.log(`\n  ${clave.nombre} no está guardada acá: vive en la bóveda del equipo.`);
  console.log(`  Referencia: ${clave.referencia_externa}\n`);
  process.exit(0);
}

if (archivoDestino) {
  const ruta = resolve(archivoDestino);
  const actual = existsSync(ruta) ? readFileSync(ruta, "utf8") : "";
  const { contenido, agregadas, reemplazadas, sinCambio } = mergeEnv(actual, { [clave.nombre]: clave.valor });
  writeFileSync(ruta, contenido, { mode: 0o600 });
  const que = agregadas.length ? "agregada" : reemplazadas.length ? "reemplazada" : sinCambio.length ? "ya estaba igual" : "escrita";
  console.log(`\n  ${clave.nombre} ${que} en ${archivoDestino}.`);
  console.log("  Revisá que ese archivo esté en el .gitignore antes de commitear.\n");
} else if (alPortapapeles(clave.valor)) {
  console.log(`\n  ${clave.nombre} copiada al portapapeles. Pegala donde la necesites.`);
  if (clave.descripcion) console.log(`  ${clave.descripcion}`);
  console.log("  El valor no pasó por esta conversación.\n");
} else {
  salir("one-brain: no pude copiar al portapapeles en esta máquina.\n" +
    "Probá con --a <archivo.env> para escribirla a un archivo de entorno.");
}
