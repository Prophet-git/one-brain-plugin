#!/usr/bin/env node
// onebrain-project-push — dejar el proyecto listo para que otro lo retome.
//
// Uso: onebrain-project-push <proyecto> [--dir <ruta>] [--env <archivo>]... [--excluir A,B]
//
// Detecta solo el repo, la rama, cómo se levanta y cómo se deploya, y muestra los NOMBRES de
// las variables encontradas para que la persona apruebe cuáles suben. La confirmación es por
// nombre y nunca por valor: mostrar el secreto en pantalla para confirmarlo sería escribirlo en
// el transcript justo cuando lo estamos protegiendo.

import { readFileSync, existsSync } from "node:fs";
import { execFileSync } from "node:child_process";
import { homedir } from "node:os";
import { join, resolve } from "node:path";
import { nombresDeEnv, leerEnv } from "../scripts/project-lib.mjs";
import { preguntar, esSi } from "../scripts/tty.mjs";

const URL_BASE = process.env.ONE_BRAIN_URL || "https://onebrain.prophet.lat";
const ENV_CANDIDATOS = [".env.local", ".env", ".env.production.local"];

function salir(msg, codigo = 1) { console.error(msg); process.exit(codigo); }

function token() {
  const f = join(process.env.ONE_BRAIN_CONFIG_DIR || join(homedir(), ".config", "one-brain"), "token");
  if (!existsSync(f)) salir("one-brain: sin token. Corré /one-brain:connect <token>.");
  return readFileSync(f, "utf8").trim();
}

/** Igual que en el pull: la confirmación se le pide a la terminal, no a la entrada estándar,
 *  así el modelo no puede aprobar una subida de credenciales por su cuenta. */
function confirmarEnTerminal(pregunta) {
  const r = preguntar(pregunta);
  if (r === null) salir("one-brain: hace falta una terminal para confirmar qué credenciales se suben.");
  return esSi(r);
}

function git(dir, ...args) {
  try {
    return execFileSync("git", ["-C", dir, ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
  } catch { return null; }
}

/** Cómo se deploya, con lo que se pueda leer del repo. Es una PROPUESTA: la persona la corrige
 *  si está mal. Preferimos ofrecer algo concreto y editable antes que una pregunta abierta que
 *  nadie contesta al final del día. */
function detectarDeploy(dir) {
  const runbook = ["docs/runbooks/deploy.md", "DEPLOY.md"].find((f) => existsSync(join(dir, f)));
  if (runbook) return `ver ${runbook}`;
  if (existsSync(join(dir, "vercel.json"))) return "vercel deploy --prod";
  const pkg = join(dir, "package.json");
  if (existsSync(pkg)) {
    try {
      const scripts = JSON.parse(readFileSync(pkg, "utf8")).scripts || {};
      if (scripts.deploy) return `npm run deploy`;
    } catch { /* package.json roto: no es asunto de este comando */ }
  }
  return null;
}

function detectarSetup(dir) {
  if (existsSync(join(dir, "pnpm-lock.yaml"))) return "pnpm install && pnpm dev";
  if (existsSync(join(dir, "package-lock.json"))) return "npm install && npm run dev";
  if (existsSync(join(dir, "requirements.txt"))) return "pip install -r requirements.txt";
  return null;
}

const args = process.argv.slice(2);
const proyecto = args.find((a) => !a.startsWith("--") && args[args.indexOf(a) - 1] !== "--dir" && args[args.indexOf(a) - 1] !== "--env" && args[args.indexOf(a) - 1] !== "--excluir");
if (!proyecto) salir("uso: onebrain-project-push <proyecto> [--dir <ruta>] [--env <archivo>] [--excluir A,B]");
const dirIdx = args.indexOf("--dir");
const dir = resolve(dirIdx >= 0 ? args[dirIdx + 1] : process.cwd());
const excluirIdx = args.indexOf("--excluir");
const excluidas = new Set(excluirIdx >= 0 ? args[excluirIdx + 1].split(",").map((s) => s.trim()) : []);
const envPedidos = args.reduce((acc, a, i) => (a === "--env" ? [...acc, args[i + 1]] : acc), []);

const perfil = {
  repo_url: git(dir, "remote", "get-url", "origin"),
  default_branch: git(dir, "rev-parse", "--abbrev-ref", "HEAD"),
  setup_md: detectarSetup(dir),
  deploy_md: detectarDeploy(dir),
};

const archivosEnv = (envPedidos.length ? envPedidos : ENV_CANDIDATOS).filter((f) => existsSync(join(dir, f)));

console.log(`\n  Voy a dejar esto en el cerebro, para ${proyecto}:\n`);
console.log(`    Repo ......... ${perfil.repo_url || "(no encontré remoto git)"}`);
console.log(`    Rama ......... ${perfil.default_branch || "?"}`);
console.log(`    Se levanta ... ${perfil.setup_md || "(no detecté: cargalo después)"}`);
console.log(`    Se deploya ... ${perfil.deploy_md || "(no detecté: cargalo después)"}`);

const sinPushear = git(dir, "status", "--porcelain");
if (sinPushear) console.log(`\n    OJO: tenés cambios sin commitear en este repo.`);

const secretos = [];
for (const archivo of archivosEnv) {
  const contenido = readFileSync(join(dir, archivo), "utf8");
  const nombres = nombresDeEnv(contenido).filter((n) => !excluidas.has(n));
  if (!nombres.length) continue;
  console.log(`\n    Credenciales en ${archivo} (${nombres.length}):`);
  for (const n of nombres) console.log(`      ${n}`);
  const valores = leerEnv(contenido);
  for (const n of nombres) {
    secretos.push({ nombre: n, destino_tipo: "env", destino: archivo, valor: valores[n] });
  }
}

if (!secretos.length) console.log("\n    (sin credenciales para subir)");
console.log("\n  Los VALORES no se muestran acá ni viajan por la conversación.");

if (!confirmarEnTerminal("\n  ¿Subo esto al cerebro?")) {
  salir("\n  Cancelado. No se subió nada.\n", 0);
}

const res = await fetch(`${URL_BASE}/api/project`, {
  method: "POST",
  headers: { authorization: `Bearer ${token()}`, "content-type": "application/json" },
  body: JSON.stringify({ project: proyecto, profile: perfil, secretos, origen: perfil.repo_url || dir }),
});
const cuerpo = await res.json().catch(() => ({}));
if (!res.ok) salir(`one-brain: ${cuerpo.error || `el server respondió ${res.status}`}`);

console.log(`\n  Listo: ${cuerpo.guardados?.length || 0} credencial(es) y el perfil de ${cuerpo.project?.name}.`);
console.log(`  Tu compañero lo retoma con: /one-brain:retomar ${cuerpo.project?.slug}\n`);
